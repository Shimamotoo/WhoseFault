# Provedores de IA
GEMINI_API_KEY=
GEMINI_API_KEY_FREETIER=
GEMINI_MODEL=gemini-flash-lite-latest

# Banco de Dados PostgreSQL (Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=whosefault
POSTGRES_PORT=5432

# URLs de Conexão (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/whosefault?schema=public"
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/whosefault_test?schema=public"

# Firebase Admin SDK (Autenticação e Identidade - SPEC-06)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
