generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EvidenceType {
  HTTP_REQUEST
  HTTP_RESPONSE
  ERROR_LOG
  MANUAL_NOTE
}

model User {
  id          String       @id @default(uuid()) @db.Uuid
  firebaseUid String       @unique @map("firebase_uid") @db.VarChar(128)
  email       String?      @db.VarChar(255)
  name        String?      @db.VarChar(255)
  isAnonymous Boolean      @default(false) @map("is_anonymous")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  occurrences Occurrence[]

  @@map("users")
}

model Occurrence {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String?    @map("user_id") @db.Uuid
  apiName     String     @map("api_name") @db.VarChar(255)
  url         String     @db.VarChar(2048)
  method      String     @db.VarChar(10)
  description String?    @db.Text
  title       String     @db.VarChar(255)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  evidences   Evidence[]
  diagnosis   Diagnosis?
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("occurrences")
}

model Diagnosis {
  id           String     @id @default(uuid()) @db.Uuid
  occurrenceId String     @unique @map("occurrence_id") @db.Uuid
  context      Json       @db.JsonB
  result       Json       @db.JsonB
  isOutdated   Boolean    @default(false) @map("is_outdated")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  occurrence Occurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  @@map("diagnoses")
}

model Evidence {
  id           String       @id @default(uuid()) @db.Uuid
  occurrenceId String       @map("occurrence_id") @db.Uuid
  type         EvidenceType
  method       String?      @db.VarChar(10)
  url          String?      @db.VarChar(2048)
  statusCode   Int?         @map("status_code")
  headers      Json?        @db.JsonB
  payload      String?      @db.Text
  body         String?      @db.Text
  content      String?      @db.Text
  context      String?      @db.VarChar(2000)
  notes        String?      @db.VarChar(2000)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  occurrence Occurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  @@index([occurrenceId])
  @@map("evidences")
}
